          <mxGeometry x="290" y="1640" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Two locks&lt;/b&gt;&lt;br&gt;Modules/Admin/Web.config denies non-admins, and every CourseModerationManager method re-checks IsUserInRole(Admin)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="185" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Quick approve&lt;/b&gt;&lt;br&gt;Pending rows on the list also have Approve, with the same confirm. Reject needs this page, because it needs a reason." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="425" width="200" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="Delete works in every status, including Pending Review. See Flowchart 3." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="665" width="200" height="80" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="Approved: learners can enrol straight away. Rejected: back to Draft, and the tutor sees the feedback in the Course builder." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="1385" width="200" height="110" as="geometry" />
