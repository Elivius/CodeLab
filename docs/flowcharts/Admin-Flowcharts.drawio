        <mxCell id="p1" value="Find the user on the Users tab&lt;br&gt;&lt;small&gt;search · role and status filters&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
