        <mxCell id="x6" value="Show error:&lt;br&gt;“account is …, so it cannot be reactivated”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
