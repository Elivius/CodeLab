        <mxCell id="x3" value="Show error:&lt;br&gt;“cannot suspend your own account”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
