  <diagram id="fc3" name="3 Course lock-unlock-delete">
    <mxGraphModel adaptiveColors="auto">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Admin Flowchart 3 – Moderate a Course: Lock, Unlock or Delete" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1450" height="30" as="geometry" />
        </mxCell>
        <mxCell id="sub" value="Based on BLL/Admin/CourseModerationManager.cs · DAL/Admin/CourseModerationRepository.cs · Modules/Admin/CourseReview.aspx.cs · Modules/Admin/Courses.aspx.cs" style="text;html=1;fontSize=12;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="40" width="1450" height="20" as="geometry" />
        </mxCell>
        <mxCell id="start" value="Start" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d1" value="Signed in as Admin?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="185" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x1" value="Access denied&lt;br&gt;&lt;small&gt;redirected away from the page&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="200" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="Open a course on Course Moderation&lt;br&gt;&lt;small&gt;list row or Review page&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="314" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d2" value="Course found?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="425" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x2" value="Show error:&lt;br&gt;“could not be found”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="440" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d3" value="Which action?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="545" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="Type reason for locking" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="554" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d4" value="Reason 10–500 chars?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="665" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="d5" value="Still Published?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="785" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x3" value="Show error:&lt;br&gt;“course is …, so it cannot be locked”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="800" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="Set status Locked, save reason&lt;br&gt;&lt;small&gt;UPDATE … WHERE Status = &#39;Published&#39;&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="914" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d6" value="Row updated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="1025" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x4" value="Show error:&lt;br&gt;“could not be locked”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1040" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="Record LOCK_COURSE&lt;br&gt;&lt;small&gt;with the reason&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="290" y="1154" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d7" value="Confirms “Unlock this course?”" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="665" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g1" value="End&lt;br&gt;&lt;small&gt;cancelled, nothing changes&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="680" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d8" value="Still Locked?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="785" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x5" value="Show error:&lt;br&gt;“course is …, so it cannot be unlocked”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="800" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="Set status Published, clear lock reason&lt;br&gt;&lt;small&gt;UPDATE … WHERE Status = &#39;Locked&#39;&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="914" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d9" value="Row updated?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1025" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x6" value="Show error:&lt;br&gt;“could not be unlocked”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="790" y="1040" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="Record UNLOCK_COURSE" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1154" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ok1" value="Show success message, reload page&lt;br&gt;&lt;small&gt;a locked course disappears for learners&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="540" y="1274" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="end1" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="540" y="1400" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="d10" value="Confirms delete?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="545" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="End&lt;br&gt;&lt;small&gt;cancelled, nothing changes&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1290" y="560" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="Read cover and lesson attachment paths&lt;br&gt;&lt;small&gt;before the rows are gone&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="674" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p6" value="Delete in one transaction&lt;br&gt;&lt;small&gt;quiz first, then the course; the rest cascades&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="794" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="d11" value="Delete succeeded?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="905" width="200" height="90" as="geometry" />
        </mxCell>
        <mxCell id="x7" value="Show error:&lt;br&gt;“could not be deleted”" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="1290" y="920" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p7" value="Delete cover and lesson files&lt;br&gt;&lt;small&gt;from ~/Uploads&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1034" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="Record DELETE_COURSE&lt;br&gt;&lt;small&gt;names the tutor and enrolled count&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1154" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ok2" value="Back to Course Moderation&lt;br&gt;&lt;small&gt;“… was deleted” message&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1274" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="end2" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="1400" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Buttons shown by status&lt;/b&gt;&lt;br&gt;Lock: Published only · Unlock: Locked only · Delete: every status (Draft, Pending Review, Published, Locked). The BLL checks the status again on click." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="450" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Two locks&lt;/b&gt;&lt;br&gt;Web.config denies non-admins, and every CourseModerationManager method re-checks IsUserInRole(Admin)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="305" width="450" height="70" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Why the quiz first?&lt;/b&gt;&lt;br&gt;Quizzes.CourseId is ON DELETE SET NULL, so the quiz would be left without a course. Lessons, enrolments, completions, the challenge and discussions cascade." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="185" width="200" height="170" as="geometry" />
        </mxCell>
        <mxCell id="n4" value="The delete dialog shows how many students are enrolled." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1290" y="425" width="200" height="80" as="geometry" />
        </mxCell>
