        </mxCell>
        <mxCell id="n3" value="A rejected tutor sees the reason on their Profile and can resubmit, which sets the status back to Pending." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
