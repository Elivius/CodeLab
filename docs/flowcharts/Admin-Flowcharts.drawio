        </mxCell>
        <mxCell id="x1" value="Access denied&lt;br&gt;&lt;small&gt;redirected away from the page&lt;/small&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;" vertex="1" parent="1">
