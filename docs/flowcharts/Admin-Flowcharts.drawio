        <mxCell id="n1" value="&lt;b&gt;Two locks&lt;/b&gt;&lt;br&gt;Modules/Admin/Web.config denies non-admins, and every TutorApprovalManager method re-checks IsUserInRole(Admin)." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
