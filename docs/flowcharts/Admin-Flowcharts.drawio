        <mxCell id="p2" value="Click Suspend, Reactivate or Delete&lt;br&gt;&lt;small&gt;on the row or on the Edit page&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;" vertex="1" parent="1">
