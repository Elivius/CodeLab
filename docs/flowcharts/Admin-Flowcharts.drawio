        <mxCell id="a3" value="Record DELETE_USER" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1274" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="ok2" value="Back to the Users list&lt;br&gt;&lt;small&gt;“… account was deleted”&lt;/small&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1394" width="200" height="72" as="geometry" />
        </mxCell>
        <mxCell id="end2" value="End" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=14;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1080" y="1520" width="200" height="60" as="geometry" />
        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;Buttons shown only when allowed&lt;/b&gt;&lt;br&gt;Suspend: Active accounts · Reactivate: Suspended accounts · Delete: accounts with no activity. All three are hidden on your own account. The BLL checks again on click." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="185" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="&lt;b&gt;Activity&lt;/b&gt; means courses taught, enrolments, lesson completions, quizzes, quiz attempts, code submissions, forum posts or replies, badges or audit entries. Logging in writes an audit entry, so in practice only an unused account can be deleted." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="1080" y="185" width="460" height="110" as="geometry" />
        </mxCell>
        <mxCell id="n3" value="&lt;b&gt;Suspend takes effect&lt;/b&gt;&lt;br&gt;Global.asax checks every request and signs a suspended user out on their next click." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="1265" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="legend" value="&lt;font color=&quot;#82b366&quot;&gt;■&lt;/font&gt; Start, End, success &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#6c8ebf&quot;&gt;■&lt;/font&gt; Step &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#d6b656&quot;&gt;■&lt;/font&gt; Decision &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#9673a6&quot;&gt;■&lt;/font&gt; Audit log entry &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#b85450&quot;&gt;■&lt;/font&gt; Ends with an error message &amp;nbsp;&amp;nbsp; &lt;font color=&quot;#999999&quot;&gt;■&lt;/font&gt; Note" style="text;html=1;fontSize=12;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="1610" width="1500" height="24" as="geometry" />
