        </mxCell>
        <mxCell id="n1" value="&lt;b&gt;No restore&lt;/b&gt;&lt;br&gt;Restoring would replace the database everyone is using, so there is no restore button." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="182" width="200" height="100" as="geometry" />
        </mxCell>
        <mxCell id="n2" value="IIS never serves App_Data, so BackupManager is the only way to get a backup file." style="shape=note;size=14;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;spacingRight=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="426" width="200" height="80" as="geometry" />
