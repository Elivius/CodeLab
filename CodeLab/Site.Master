<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="CodeLab.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>CodeLab<%: string.IsNullOrEmpty(Page.Title) ? "" : " - " + Page.Title %></title>

    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/bundles/modernizr") %>
    </asp:PlaceHolder>

    <%-- Applies the saved theme before the page paints, so there is no flash of the wrong colours --%>
    <script>
        (function () {
            var theme = null;
            try { theme = localStorage.getItem('codelab-theme'); } catch (e) { }
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&amp;display=swap" rel="stylesheet" />

    <webopt:bundlereference runat="server" path="~/Content/css" />
    <link rel="stylesheet" href="<%= ResolveUrl("~/Content/Site.css") %>?v=<%= System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Content/Site.css")).Ticks %>" />
    <link href="~/favicon.ico" rel="shortcut icon" type="image/x-icon" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server">
    </asp:ContentPlaceHolder>
</head>
<body>
    <%-- Theme toggle icons (moon/sun) --%>
    <svg xmlns="http://www.w3.org/2000/svg" style="display: none;">
        <symbol id="cl-moon" viewBox="0 0 24 24"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></symbol>
        <symbol id="cl-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></symbol>
    </svg>

    <form runat="server">
        <asp:ScriptManager runat="server">
            <Scripts>
                <%--To learn more about bundling scripts in ScriptManager see https://go.microsoft.com/fwlink/?LinkID=301884 --%>
                <%--Framework Scripts--%>
                <asp:ScriptReference Name="MsAjaxBundle" />
                <asp:ScriptReference Name="jquery" />
                <asp:ScriptReference Name="WebForms.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebForms.js" />
                <asp:ScriptReference Name="WebUIValidation.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebUIValidation.js" />
                <asp:ScriptReference Name="MenuStandards.js" Assembly="System.Web" Path="~/Scripts/WebForms/MenuStandards.js" />
                <asp:ScriptReference Name="GridView.js" Assembly="System.Web" Path="~/Scripts/WebForms/GridView.js" />
                <asp:ScriptReference Name="DetailsView.js" Assembly="System.Web" Path="~/Scripts/WebForms/DetailsView.js" />
                <asp:ScriptReference Name="TreeView.js" Assembly="System.Web" Path="~/Scripts/WebForms/TreeView.js" />
                <asp:ScriptReference Name="WebParts.js" Assembly="System.Web" Path="~/Scripts/WebForms/WebParts.js" />
                <asp:ScriptReference Name="Focus.js" Assembly="System.Web" Path="~/Scripts/WebForms/Focus.js" />
                <asp:ScriptReference Name="WebFormsBundle" />
                <%--Site Scripts--%>
            </Scripts>
        </asp:ScriptManager>

        <nav class="navbar navbar-expand-md navbar-light sticky-top cl-navbar">
            <div class="container">
                <a id="lnkBrand" class="cl-brand" runat="server" href="~/">
                    <img src="~/Content/Images/logo.png" runat="server" alt="CodeLab Logo" class="cl-logo" />
                    <span>Code<b>Lab</b></span>
                </a>
                <button type="button" class="navbar-toggler" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" title="Toggle navigation" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-end">
                    <ul class="navbar-nav align-items-md-center gap-md-2">
                        <%-- Guest links; hidden for every signed-in user (they use their module links, tutors their sidebar) --%>
                        <asp:PlaceHolder ID="phPublicNav" runat="server">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/">Landing</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/#courses">Courses</a></li>
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/#about">About</a></li>
                        </asp:PlaceHolder>

                        <%-- Add the links for your module inside the PlaceHolder for its role --%>
                        <asp:PlaceHolder ID="phAdminNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Modules/Admin/AuditLogs">Audit Logs</a></li>
                        </asp:PlaceHolder>
                        <%-- Empty on purpose: Tutor pages have their own sidebar (Modules/Tutor/Tutor.Master) --%>
                        <asp:PlaceHolder ID="phTutorNav" runat="server" Visible="false">
                            <li class="nav-item"><a class="nav-link" runat="server" href="~/Modules/Learner/DiscussionForum?scope=general">Discussion Forum</a></li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phLearnerNav" runat="server" Visible="false">
                        </asp:PlaceHolder>

                        <asp:PlaceHolder ID="phSignedOut" runat="server">
                            <li class="nav-item ms-md-3"><a class="nav-link" runat="server" href="~/Modules/Public/Login">Log in</a></li>
                            <li class="nav-item"><a class="btn btn-primary" runat="server" href="~/Modules/Public/Register">Register</a></li>
                        </asp:PlaceHolder>
                        <asp:PlaceHolder ID="phSignedIn" runat="server" Visible="false">
                            <li class="nav-item dropdown cl-account-nav ms-md-3">
                                <button type="button" class="cl-account-toggle" id="accountMenuToggle" aria-controls="accountMenuPanel" aria-expanded="false" aria-label="Open account menu">
                                    <span class="cl-account-avatar"><% if(!string.IsNullOrEmpty(AccountAvatar)){ %><img src="<%: AccountAvatar %>" alt="" referrerpolicy="no-referrer" /><% }else{ %><%: AccountInitial %><% } %></span>
                                    <span class="cl-account-name"><%: CodeLab.Helpers.SessionHelper.GetCurrentFullName() %></span><svg class="cl-account-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
                                </button>
                                <div id="accountMenuPanel" class="cl-account-menu" hidden>
                                    <div class="cl-account-heading"><strong><asp:Label ID="lblCurrentUser" runat="server" /></strong><small>ACTIVE ROLE: <%: CodeLab.Helpers.SessionHelper.GetCurrentRole() %></small></div>
                                    <a class="dropdown-item" href="<%: AccountProfileUrl %>"><svg class="cl-account-icon" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21a8 8 0 0 1 16 0"/></svg> My Profile</a>
                                    <asp:LinkButton ID="btnLogout" runat="server" CssClass="dropdown-item" CausesValidation="false" OnClick="btnLogout_Click"><svg class="cl-account-icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M9 4H4v16h5M10 12h11m-4-4 4 4-4 4" /></svg>Sign out</asp:LinkButton>
                                </div>
                            </li>                        </asp:PlaceHolder>

                        <li class="nav-item ms-md-2">
                            <button type="button" id="btnThemeToggle" class="cl-theme-toggle" title="Switch between light and dark mode" aria-label="Switch between light and dark mode">
                                <svg class="cl-icon cl-theme-light" aria-hidden="true"><use href="#cl-moon" /></svg>
                                <svg class="cl-icon cl-theme-dark" aria-hidden="true"><use href="#cl-sun" /></svg>
                                
                                
                            </button>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="container body-content">
            <asp:ContentPlaceHolder ID="MainContent" runat="server">
            </asp:ContentPlaceHolder>
        </div>

        <footer class="cl-footer">
            <div class="container d-flex flex-wrap align-items-center justify-content-between gap-3">
                <div class="d-flex align-items-center gap-3">
                    <a id="lnkFooterBrand" class="cl-brand" runat="server" href="~/">
                        <img src="~/Content/Images/logo.png" runat="server" alt="CodeLab Logo" class="cl-logo" />
                        <span>Code<b>Lab</b></span>
                    </a>
                    <span>&copy; <%: DateTime.Now.Year %> CodeLab. All rights reserved.</span>
                </div>
                <div class="d-flex gap-4">
                    <a href="#">Terms</a>
                    <a href="#">Privacy</a>
                    <a href="#">Contact</a>
                </div>
            </div>
        </footer>
    </form>
    <asp:PlaceHolder runat="server">
        <%: Scripts.Render("~/Scripts/bootstrap.js") %>
    </asp:PlaceHolder>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        function initIcons() {
            if (window.lucide) {
                lucide.createIcons();
            }
        }
        document.addEventListener('DOMContentLoaded', initIcons);
        if (typeof Sys !== 'undefined' && Sys.WebForms && Sys.WebForms.PageRequestManager) {
            Sys.WebForms.PageRequestManager.getInstance().add_endRequest(initIcons);
        }
        document.getElementById('btnThemeToggle').addEventListener('click', function () {
            var root = document.documentElement;
            var theme = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            root.setAttribute('data-theme', theme);
            try { localStorage.setItem('codelab-theme', theme); } catch (e) { }
        });
    </script>
    <button type="button" id="clBackToTop" class="cl-back-top" aria-label="Back to top" title="Back to top" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15" /></svg></button>
    <script src="<%= ResolveUrl("~/Scripts/site-ui.js") %>?v=<%= System.IO.File.GetLastWriteTimeUtc(Server.MapPath("~/Scripts/site-ui.js")).Ticks %>"></script>
</body>
</html>
