<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.Mobile.master.cs" Inherits="CodeLab.Site_Mobile" %>
<%@ Register Src="~/ViewSwitcher.ascx" TagPrefix="friendlyUrls" TagName="ViewSwitcher" %>

<!DOCTYPE html>
<html xmlns="http://www.w3.org/1999/xhtml">
<head runat="server">
    <meta name="viewport" content="width=device-width" />
    <title></title>
    <asp:ContentPlaceHolder runat="server" ID="HeadContent" />
</head>
<body>
    <form id="form1" runat="server">
    <div>
        <h1>Mobile Master Page</h1>
        <asp:ContentPlaceHolder runat="server" ID="FeaturedContent" />
        <section class="content-wrapper main-content clear-fix">
            <asp:ContentPlaceHolder runat="server" ID="MainContent" />
        </section>
        <friendlyUrls:ViewSwitcher runat="server" />
    </div>
    </form>
    <style>
        .cl-back-top{position:fixed;right:24px;bottom:calc(24px + env(safe-area-inset-bottom,0px));z-index:1040;width:44px;height:44px;display:grid;place-items:center;padding:0;border:1px solid #f6b6cd;border-radius:50%;background:linear-gradient(135deg,#b93b69,#d64578);color:#fff;box-shadow:0 4px 16px #b93b6933;cursor:pointer;transition:transform .15s,box-shadow .15s}
        .cl-back-top[hidden]{display:none!important}.cl-back-top:hover{transform:translateY(-3px);box-shadow:0 6px 20px #b93b6944}.cl-back-top:focus-visible{outline:3px solid #c9527d;outline-offset:4px}.cl-back-top svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}@media(max-width:640px){.cl-back-top{right:16px;bottom:calc(16px + env(safe-area-inset-bottom,0px))}}@media(prefers-reduced-motion:reduce){.cl-back-top{transition:none}}
    </style>
    <button type="button" id="clBackToTop" class="cl-back-top" aria-label="Back to top" title="Back to top" hidden><svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 7-7 7 7M12 5v15" /></svg></button>
    <script>
        (function(){
            var button=document.getElementById('clBackToTop');
            function update(){button.hidden=window.scrollY<300;}
            window.addEventListener('scroll',update,{passive:true});
            window.addEventListener('pageshow',update);
            button.addEventListener('click',function(){window.scrollTo({top:0,behavior:window.matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});});
            update();
        })();
    </script>
</body>
</html>
