<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authorization>
      <allow roles="Tutor,Admin" />
      <deny users="*" />
    </authorization>
    <!-- Allows uploads a little over the 2 MB photo limit (value in KB), so an oversized photo
         gets a friendly message from TutorManager instead of an error page -->
    <httpRuntime maxRequestLength="5120" />
  </system.web>
</configuration>
