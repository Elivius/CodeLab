<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.web>
    <authorization>
      <allow roles="Tutor,Admin" />
      <deny users="*" />
    </authorization>
    <!-- Allows uploads a little over the largest file limit (5 MB lesson attachments; value in KB), so an
         oversized file gets a friendly message from the manager instead of an error page -->
    <httpRuntime maxRequestLength="8192" />
  </system.web>
</configuration>
