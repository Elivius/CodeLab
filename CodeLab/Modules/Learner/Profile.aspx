<%@ Page Title="Profile" Language="C#" MasterPageFile="~/Site.Master" %>
<%@ Import Namespace="CodeLab.BLL" %>
<%@ Import Namespace="CodeLab.Models" %>
<%@ Import Namespace="CodeLab.Helpers" %>
<%@ Import Namespace="System.Linq" %>
<script runat="server">
protected LeaderboardData Board;
protected CodeLab.Models.User Account;
protected LearnerDashboardData Stats;
protected string Feedback;
protected bool Failed;
protected BadgeProgress Featured { get { return Board==null?null:Board.Badges.Find(b=>b.IsFeatured); } }
protected int Progress { get { return Stats==null || Stats.Milestone<=0?0:(int)Math.Min(100,100L*Stats.Points/Stats.Milestone); } }
protected override void OnInit(EventArgs e) { ViewStateUserKey=Session.SessionID;base.OnInit(e); }
protected void Page_Load(object sender,EventArgs e) {
 if(!SessionHelper.IsLoggedIn() || !SessionHelper.IsUserInRole("Learner")) { Response.Redirect(ResolveUrl("~/Modules/Public/Login"),false);Context.ApplicationInstance.CompleteRequest();return; }
 LoadData();if(!IsPostBack && Account!=null){BindFields();BindBadges();}
}
private void LoadData() {
 var a=new UserManager().GetLearnerProfile();if(!a.Success){Feedback=a.Message;Failed=true;return;}Account=a.Data;
 var b=new LeaderboardManager().GetPage(1);if(!b.Success){Feedback=b.Message;Failed=true;return;}Board=b.Data;
 try {Stats=new LearnerManager().GetDashboard(Account.Id);}catch(System.Data.SqlClient.SqlException){Feedback="Learning statistics are temporarily unavailable.";Failed=true;}

}
private void BindBadges(){if(Board!=null){badgeList.DataSource=Board.Badges;badgeList.DataBind();}}
protected override void OnPreRender(EventArgs e){BindBadges();base.OnPreRender(e);}
private void BindFields(){fullName.Text=Account.FullName;username.Text=Account.Username;email.Text=Account.Email;}
private void Result(OperationResult result,string message,string tab){activeTab.Value=tab;Failed=!result.Success;Feedback=result.Success?message:result.Message;if(result.Success)LoadData();}
protected void SaveAccount(object sender,EventArgs e){Result(new UserManager().SaveLearnerProfile(fullName.Text,username.Text,email.Text),"Profile changes saved.","account");if(!Failed)BindFields();}
protected void SavePassword(object sender,EventArgs e){Result(new UserManager().ChangeLearnerPassword(currentPassword.Text,newPassword.Text,confirmPassword.Text),"Password updated successfully.","security");currentPassword.Text="";newPassword.Text="";confirmPassword.Text="";}
protected void BadgeCommand(object source,System.Web.UI.WebControls.RepeaterCommandEventArgs e){int id;if(int.TryParse(Convert.ToString(e.CommandArgument),out id))Result(new LeaderboardManager().SetFeaturedBadge(id),"Featured badge updated.","badges");}
protected void RemoveBadge(object sender,EventArgs e){Result(new LeaderboardManager().SetFeaturedBadge(0),"Featured badge removed.","badges");}
protected void UploadAvatar(object sender,EventArgs e){Result(photoUpload.HasFile?new UserManager().UploadLearnerAvatar(photoUpload.FileName,photoUpload.PostedFile.ContentLength,photoUpload.FileContent):OperationResult.Fail("Choose a photo first."),"Profile photo uploaded.","account");}
protected string BadgeTier(BadgeProgress badge){return LeaderboardManager.GetBadgeTier(badge);}
protected BadgeProgress NextMilestone {get{return Board==null?null:Board.Badges.FindAll(b=>b.Metric=="points" && b.Target>Board.Me.Points).OrderBy(b=>b.Target).FirstOrDefault();}}
protected void SaveAvatar(object sender,EventArgs e){int id;if(int.TryParse(avatarChoice.SelectedValue,out id))Result(new UserManager().SetLearnerAvatar(id),"Avatar updated.","account");}
protected string Initial {get{return Account==null || string.IsNullOrWhiteSpace(Account.FullName)?"?":System.Globalization.StringInfo.GetNextTextElement(Account.FullName).ToUpperInvariant();}}
protected string Avatar(){string v=Account==null?null:Account.AvatarUrl;if(string.IsNullOrEmpty(v))return null;if(v.StartsWith("~/Uploads/Avatars/")&&!v.Contains("..")&&!v.Contains("\\"))return ResolveUrl(v);Uri u;return Uri.TryCreate(v,UriKind.Absolute,out u)&&(u.Scheme=="http"||u.Scheme=="https")?u.AbsoluteUri:null;}
</script>
