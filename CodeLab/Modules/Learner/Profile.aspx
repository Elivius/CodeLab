"50" autocomplete="username" /></div></div><div class="pf-wide"><asp:Label runat="server" AssociatedControlID="email" Text="Email Address (Primary notifications)" /><div class="pf-input-wrap"><svg class="pf-svg" aria-hidden="true"><use href="#pf-mail" /></svg><asp:TextBox ID="email" runat="server" CssClass="pf-input" MaxLength="255" TextMode="Email" autocomplete="email" /></div></div></div><div class="pf-actions"><span class="pf-muted">Learner ID: <%: Account.Id %> &middot; Joined <%: Account.JoinedDate.ToString("MMM yyyy") %></span><button runat="server" id="saveAccountButton" onserverclick="SaveAccount" class="pf-button"><svg class="pf-svg" aria-hidden="true"><use href="#pf-save" /></svg>Save Profile Changes</button></div></section><section class="pf-panel" id="panel-security" role="tabpanel" aria-labelledby="tab-security" hidden><header class="pf-heading"><h2><svg class="pf-svg" aria-hidden="true"><use href="#pf-shield" /></svg>Account Security &amp; Password Settings</h2><p class="pf-muted">Use at least 8 characters and include a number.</p></header><div class="pf-form"><div class="pf-wide"><asp:Label runat="server" AssociatedControlID="currentPassword" Text="Current password" /><div class="pf-input-wrap"><svg class="pf-svg" aria-hidden="true"><use href="#pf-lock" /></svg><asp:TextBox placeholder="Enter current password" ID="currentPassword" runat="server" CssClass="pf-input" TextMode="Password" autocomplete="new-password" /></div></div><div class=""><asp:Label runat="server" AssociatedControlID="newPassword" Text="New password" /><div class="pf-input-wrap"><svg class="pf-svg" aria-hidden="true"><use href="#pf-shield" /></svg><asp:TextBox placeholder="Enter new password" ID="newPassword" runat="server" CssClass="pf-input" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div></div><div class=""><asp:Label runat="server" AssociatedControlID="confirmPassword" Text="Confirm new password" /><div class="pf-input-wrap"><svg class="pf-svg" aria-hidden="true"><use href="#pf-lock" /></svg><asp:TextBox placeholder="Confirm new password" ID="confirmPassword" runat="server" CssClass="pf-input" TextMode="Password" MaxLength="128" autocomplete="new-password" /></div></div></div><div class="pf-password-rules"><strong>Password Requirements:</strong><div><span>• At least 8 characters</span><span>• At least one digit (0–9)</span><span>• Passwords match</span></div></div><div class="pf-actions pf-password-actions"><button runat="server" id="savePasswordButton" onserverclick="SavePassword" class="pf-button"><svg class="pf-svg" aria-hidden="true"><use href="#pf-shield" /></svg>Update Password</button></div></section><section class="pf-panel pf-badges-panel" id="panel-badges" role="tabpanel" aria-labelledby="tab-badges" hidden><div class="pf-card"><header class="pf-preview-heading"><div><h2><svg class="pf-svg" aria-hidden="true"><use href="#pf-user" /></svg> Live Forum Representation Preview</h2><p class="pf-muted">This shows how your name and worn badge appear to tutors and peers across discussions and replies.</p></div><div class="pf-preview-actions"><asp:Button runat="server" Text="Unequip" ID="removeBadgeButton" OnClick="RemoveBadge" CssClass="pf-button pf-secondary" /></div></header><div class="pf-preview"><div class="pf-preview-author"><span class="pf-preview-avatar"><% if(Avatar()!=null){ %><img src="<%: Avatar() %>" alt="" referrerpolicy="no-referrer" /><% }else{ %><%: Initial %><% } %></span><div><div class="pf-name"><strong><%: Account.FullName %></strong><% if(Featured!=null){ %><span class="cl-earned-badge tier-<%: BadgeTier(Featured).ToLowerInvariant() %>">&#9733; <%: Featured.Name %></span><% } %><span class="pf-preview-role">Learner</span><span class="pf-preview-you">You</span></div><p class="pf-muted">@<%: Account.Username %> · Posted in General Discussion</p></div><small class="pf-muted pf-preview-time">Just now</small></div><div class="pf-preview-message">This is a preview of your discussion message. Your chosen badge appears beside your name.</div></div></div><div class="pf-card"><header class="pf-collection-heading"><div><h2>Achievement Badges Collection</h2><p class="pf-muted">Choose an unlocked badge to wear beside your name.</p></div><div class="pf-status-switch" aria-label="Badge status">
