<% if(current){ %><span class="pf-current-label">Current</span><% } %></article><% } %></div></div><div class="pf-stats"><article class="pf-stat"><div><h3><svg class="pf-svg" aria-hidden="true"><use href="#ld-book" /></svg>Curriculum Courses</h3><strong><%: Stats==null?"—":Stats.Enrolled.ToString() %> Enrolled</strong></div><p class="pf-muted">Your course enrollments and curriculum progress.</p></article><article class="pf-stat"><div><h3><svg class="pf-svg" aria-hidden="true"><use href="#pf-check" /></svg>Quiz Evaluations</h3><strong><%: Board.Me.Counts.Quizzes %> Passed</strong></div><p class="pf-muted">Distinct quizzes you have successfully passed.</p></article><article class="pf-stat"><div><h3><svg class="pf-svg" aria-hidden="true"><use href="#ld-terminal" /></svg>CodeLab Workspace</h3><strong><%: Board.Me.Counts.Challenges %> Solved</strong></div><p class="pf-muted">Distinct coding challenges you have successfully solved.</p></article></div></section><dialog id="avatarDialog" class="pf-dialog"><div class="pf-actions" style="margin-top:0"><h2 style="font-size:18px">Choose Profile Avatar</h2><button type="button" class="pf-button pf-secondary" onclick="document.getElementById('avatarDialog').close()" aria-label="Close avatar picker">×</button></div><p class="pf-muted">Choose a developer avatar or use your initials.</p><div class="pf-upload"><asp:Label runat="server" AssociatedControlID="photoUpload" Text="Upload your own photo" /><asp:FileUpload ID="photoUpload" runat="server" CssClass="pf-input" accept="image/jpeg,image/png,image/webp" /><small class="pf-muted">JPG, PNG or WebP · Maximum 2 MB</small><asp:Button runat="server" Text="Upload photo" ID="uploadAvatarButton" OnClick="UploadAvatar" CssClass="pf-button" /></div><p class="pf-muted">Or choose a preset</p><div class="pf-presets"><button type="button" data-avatar="1" aria-pressed="false"><img src="https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Default Developer</button><button type="button" data-avatar="2" aria-pressed="false"><img src="https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Modern Engineer</button><button type="button" data-avatar="3" aria-pressed="false"><img src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Systems Architect</button><button type="button" data-avatar="4" aria-pressed="false"><img src="https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Data Specialist</button><button type="button" data-avatar="5" aria-pressed="false"><img src="https://images.unsplash.com/photo-1580489944761-15a19d654956?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Frontend Craftsman</button><button type="button" data-avatar="6" aria-pressed="false"><img src="https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=150&amp;auto=format&amp;fit=crop&amp;q=80" alt="" loading="lazy" referrerpolicy="no-referrer" />Full-Stack Polyglot</button></div><asp:Label runat="server" AssociatedControlID="avatarChoice" Text="Avatar" /><asp:DropDownList ID="avatarChoice" ClientIDMode="Static" runat="server" CssClass="pf-input"><asp:ListItem Value="0">Use my initials</asp:ListItem><asp:ListItem Value="1">Default Developer</asp:ListItem><asp:ListItem Value="2">Modern Engineer</asp:ListItem><asp:ListItem Value="3">Systems Architect</asp:ListItem><asp:ListItem Value="4">Data Specialist</asp:ListItem><asp:ListItem Value="5">Frontend Craftsman</asp:ListItem><asp:ListItem Value="6">Full-Stack Polyglot</asp:ListItem></asp:DropDownList><div class="pf-actions"><asp:Button runat="server" Text="Save avatar" ID="saveAvatarButton" OnClick="SaveAvatar" CssClass="pf-button" /></div></dialog><% } %></div></main><script>(function(){
const tabs=Array.from(document.querySelectorAll('[data-tab]')),field=document.getElementById('activeTab');
function show(name){if(!tabs.some(t=>t.dataset.tab===name))name='account';field.value=name;tabs.forEach(t=>{const selected=t.dataset.tab===name;t.setAttribute('aria-selected',String(selected));t.tabIndex=selected?0:-1;document.getElementById('panel-'+t.dataset.tab).hidden=!selected;});}
tabs.forEach((tab,i)=>{tab.addEventListener('click',()=>show(tab.dataset.tab));tab.addEventListener('keydown',e=>{if(e.key==='ArrowRight'||e.key==='ArrowLeft'){e.preventDefault();const next=tabs[(i+(e.key==='ArrowRight'?1:tabs.length-1))%tabs.length];show(next.dataset.tab);next.focus();}});});
document.querySelectorAll('[data-open-tab]').forEach(b=>b.addEventListener('click',()=>{show(b.dataset.openTab);document.getElementById('tab-'+b.dataset.openTab).focus();}));if(tabs.length)show(field.value);
let badgePage=1;
function renderBadges(){const status=document.getElementById('badgeStatus').value,category=document.getElementById('badgeCategory').value;const cards=Array.from(document.querySelectorAll('.pf-badge'));const matching=cards.filter(b=>(status==='all'||status===b.dataset.status)&&(category==='all'||category===b.dataset.category));const pages=Math.max(1,Math.ceil(matching.length/8));badgePage=Math.min(pages,Math.max(1,badgePage));cards.forEach(b=>b.hidden=true);matching.slice((badgePage-1)*8,badgePage*8).forEach(b=>b.hidden=false);document.getElementById('badgeEmpty').hidden=matching.length>0;document.getElementById('badgePrev').disabled=badgePage===1;document.getElementById('badgeNext').disabled=badgePage===pages;document.querySelectorAll('[data-category-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.categoryFilter===category)));document.getElementById('badgePageStatus').textContent='Badge page '+badgePage+' of '+pages;document.querySelectorAll('[data-status-filter]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.statusFilter===status)));}
function filter(){badgePage=1;renderBadges();}
['badgeStatus','badgeCategory'].forEach(id=>{const el=document.getElementById(id);if(el)el.addEventListener('change',filter);});document.querySelectorAll('[data-status-filter]').forEach(b=>b.addEventListener('click',()=>{document.getElementById('badgeStatus').value=b.dataset.statusFilter;filter();}));if(document.getElementById('badgePrev')){document.getElementById('badgePrev').addEventListener('click',()=>{badgePage--;renderBadges();});document.getElementById('badgeNext').addEventListener('click',()=>{badgePage++;renderBadges();});renderBadges();}
document.querySelectorAll('[data-category-filter]').forEach(b=>b.addEventListener('click',()=>{document.getElementById('badgeCategory').value=b.dataset.categoryFilter;filter();}));const choice=document.getElementById('avatarChoice');function selected(){document.querySelectorAll('[data-avatar]').forEach(b=>b.setAttribute('aria-pressed',String(b.dataset.avatar===choice.value)));}
document.querySelectorAll('[data-avatar]').forEach(b=>b.addEventListener('click',()=>{choice.value=b.dataset.avatar;selected();}));if(choice)choice.addEventListener('change',selected);
}());</script></asp:Content>